# ============================================================
# .env.example — Safe template. Commit this file.
# Copy to .env and fill in your real values. Never commit .env.
# ============================================================

# Google OAuth 2.0 credentials — obtained from Google Cloud Console.
# Each platform requires its own credential registered under the same project.

# Windows: register a "Web Application" OAuth client; redirect URI = http://localhost:<port>
GOOGLE_CLIENT_ID_WINDOWS=YOUR_WINDOWS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_WINDOWS=YOUR_WINDOWS_CLIENT_SECRET

# Android: register an "Android" OAuth client; no client secret needed —
# the native Google Sign-In SDK authenticates via google-services.json.
GOOGLE_CLIENT_ID_ANDROID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com

# Name of the Drive folder used for backup storage.
# Created automatically on first sync if it does not exist.
DRIVE_BACKUP_FOLDER_NAME=TodoAppBackup

# OAuth scope — do NOT widen beyond drive.appdata unless there is a
# documented user-facing requirement (rule S-7).
DRIVE_SCOPE=https://www.googleapis.com/auth/drive.appdata

# Gemini API key — used by the AI Task Breakdown feature (Phase 8).
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Auto-updater manifest URL — required when auto-update feature is enabled (rule AU-1).
# Leave empty during development.
AUTO_UPDATE_MANIFEST_URL=
