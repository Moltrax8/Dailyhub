# Bu dosyayı kopyalayıp local.properties olarak adlandır.
# ASLA git'e commit etme — .gitignore'da zaten var.

# Google Cloud Console → OAuth 2.0 Client IDs → Android
# SHA-1 fingerprint + package name ile oluşturulur.
GOOGLE_CLIENT_ID=your_web_client_id_here.apps.googleusercontent.com

# Gemini API Key (Google AI Studio'dan alınır)
GEMINI_API_KEY=your_gemini_api_key_here

# ExerciseDB API Key (RapidAPI'den alınır — opsiyonel)
EXERCISEDB_KEY=your_exercisedb_key_here

# Google Drive ayarları (değiştirmene gerek yok)
DRIVE_FOLDER_NAME=PersonalNoteAppBackup
DRIVE_SCOPE=https://www.googleapis.com/auth/drive.appdata
